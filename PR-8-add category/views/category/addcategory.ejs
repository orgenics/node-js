<%- include('../header')%>

<div class="page-wrapper" style="background: #fdfdfd; min-height: 100vh;">
    <div class="page-breadcrumb">
        <div class="row">
            <div class="col-12 d-flex no-block align-items-center">
                <h4 class="page-title text-dark fw-bold">Catalog Management</h4>
                <div class="ml-auto text-right">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb bg-transparent p-0">
                            <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Add Category</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <div class="category-icon-wrapper mb-2">
                                <i class="mdi mdi-layers text-primary" style="font-size: 40px;"></i>
                            </div>
                            <h4 class="fw-bold">New Category</h4>
                            <p class="text-muted small">Create a grouping for your products</p>
                        </div>

                        <form action="/category/add-category" method="post" enctype="multipart/form-data">
                            <div class="form-group mb-4">
                                <label class="text-uppercase small fw-bold text-muted mb-2">Category Name</label>
                                <input type="text" class="form-control custom-input" 
                                       placeholder="e.g. Electronics, Fashion..." name="categoryName" required>
                            </div>

                            <div class="form-group mb-4">
                                <label class="text-uppercase small fw-bold text-muted mb-2">Category Image</label>
                                <div class="image-upload-container">
                                    <input type="file" name="categoryImage" id="catImgInput" class="file-input" accept="image/*" required>
                                    <label for="catImgInput" class="file-drop-area" id="dropArea">
                                        <div id="preview-placeholder">
                                            <i class="mdi mdi-cloud-upload text-primary" style="font-size: 30px;"></i>
                                            <p class="mb-0 small">Click to upload or drag & drop</p>
                                        </div>
                                        <img id="imgPreview" src="#" alt="Preview" style="display: none; width: 100%; border-radius: 10px;">
                                    </label>
                                </div>
                            </div>

                            <div class="pt-3">
                                <button type="submit" class="btn btn-primary btn-block btn-lg shadow" style="border-radius: 12px; font-weight: 600;">
                                    Create Category
                                </button>
                                <a href="/category/view-categories" class="btn btn-link btn-block btn-sm text-muted mt-2">Cancel and go back</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom Input Styling */
    .custom-input {
        border: 2px solid #f1f3f5;
        border-radius: 12px;
        padding: 12px 15px;
        transition: all 0.3s ease;
        background-color: #f8f9fa;
    }
    .custom-input:focus {
        border-color: #4e73df;
        background-color: #fff;
        box-shadow: 0 4px 15px rgba(78, 115, 223, 0.1);
    }

    /* Modern File Upload Styling */
    .image-upload-container {
        position: relative;
    }
    .file-input {
        display: none;
    }
    .file-drop-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 2px dashed #d1d9e6;
        border-radius: 15px;
        padding: 30px;
        cursor: pointer;
        transition: 0.3s;
        background: #fcfcfc;
        min-height: 150px;
    }
    .file-drop-area:hover {
        background: #f0f4ff;
        border-color: #4e73df;
    }
    
    .category-icon-wrapper {
        width: 70px;
        height: 70px;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin: 0 auto;
    }
</style>

<script>
    // Live Image Preview Logic
    const imgInput = document.getElementById('catImgInput');
    const imgPreview = document.getElementById('imgPreview');
    const placeholder = document.getElementById('preview-placeholder');

    imgInput.onchange = evt => {
        const [file] = imgInput.files;
        if (file) {
            imgPreview.src = URL.createObjectURL(file);
            imgPreview.style.display = 'block';
            placeholder.style.display = 'none';
        }
    }
</script>

<%- include('../footer')%>