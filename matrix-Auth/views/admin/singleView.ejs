<%- include('../header') %>

    <div class="container mt-5">
        <div class="card shadow-lg p-4" style="border-radius:20px;">

            <img src="<%= admin.image %>" class="img-fluid mb-4"
                style="max-height:350px; object-fit:contain; border-radius: 10px;">

            <h2 class="text-center mb-3">
                <%= admin.name %>
            </h2>

            <p><b>Role:</b>
                <%= admin.role %>
            </p>
            <p><b>Email:</b>
                <%= admin.email %>
            </p>

            <hr>

            <h5>Description</h5>
            <p>
                <%= admin.description %>
            </p>

            <div class="text-center mt-4">
                <a href="/admin/view-admin" class="btn btn-secondary">Back</a>
            </div>

        </div>
    </div>

    <%- include('../footer') %>