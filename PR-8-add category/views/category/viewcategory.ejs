<%- include('../header')%>

<style>
    /* Custom Modern Styles */
    .page-wrapper { background-color: #f8f9fa; }
    .card { border: none; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
    .table thead th {
        background-color: #f1f3f9;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        font-weight: 700;
        border-bottom: none;
        color: #555;
    }
    .table td { vertical-align: middle !important; border-top: 1px solid #eee; padding: 15px 10px; }
    .category-img {
        object-fit: cover;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        transition: transform 0.2s;
    }
    .category-img:hover { transform: scale(1.1); }
    .action-btn { width: 35px; height: 35px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; margin: 0 2px; }
    .breadcrumb-item a { color: #3e5569; font-weight: 500; }
</style>

<div class="page-wrapper">
    <div class="page-breadcrumb">
        <div class="row">
            <div class="col-12 d-flex no-block align-items-center">
                <h4 class="page-title text-dark" style="font-weight: 700;">Category Management</h4>
                <div class="ml-auto text-right">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Categories</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-md-flex align-items-center mb-4">
                            <div>
                                <h5 class="card-title">All Categories</h5>
                                <p class="card-subtitle">Manage your product groupings and visual assets</p>
                            </div>
                            <div class="ml-auto mt-2 mt-md-0">
                                <a href="/category/add-category" class="btn btn-primary btn-md shadow-sm">
                                    <i class="fas fa-plus mr-2"></i> Add New Category
                                </a>
                            </div>
                        </div>

                        <div class="input-group mb-3 col-md-4 p-0">
                            <input type="text" class="form-control" placeholder="Search categories..." aria-label="Search">
                            <div class="input-group-append">
                                <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table no-wrap v-middle mb-0">
                                <thead>
                                    <tr class="border-0">
                                        <th class="border-0" width="80px">#</th>
                                        <th class="border-0">Category Details</th>
                                        <th class="border-0">Preview</th>
                                        <th class="border-0" width="150px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% category.forEach((cat, i) => { %>
                                    <tr>
                                        <td>
                                            <span class="text-muted font-weight-bold"><%= i + 1 %></span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="">
                                                    <h6 class="m-b-0 font-weight-bold text-dark"><%= cat.categoryName %></h6>
                                                    <small class="text-muted">ID: #<%= cat.id.toString().substring(0,8) %></small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <img src="<%= cat.categoryImage %>" 
                                                 alt="cat" 
                                                 class="category-img" 
                                                 width="50" height="50"
                                                 onerror="this.src='https://via.placeholder.com/50'">
                                        </td>
                                        <td>
                                            <a href="/category/edit-category/<%= cat.id %>" 
                                               class="btn btn-outline-success action-btn" 
                                               data-toggle="tooltip" title="Edit">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>
                                            <a href="/category/delete-category/<%= cat.id %>" 
                                               class="btn btn-outline-danger action-btn" 
                                               onclick="return confirm('Are you sure you want to delete this category?')"
                                               data-toggle="tooltip" title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    <% if(category.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="text-center py-5">
                                                <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="80" class="mb-3 opacity-50">
                                                <p class="text-muted">No categories found. Start by adding one!</p>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../footer')%>