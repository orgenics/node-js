<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Premium Store - Apna  Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-dark: #121212;
            --accent-color: #4f46e5;
            --accent-hover: #4338ca;
            --bg-light: #f8fafc;
            --card-border: rgba(0, 0, 0, 0.05);
            --text-main: #1e293b;
        }

        body {
            margin: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-light);
            color: var(--text-main);
        }

        /* ===== MODERN NAVBAR ===== */
        header {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            padding: 12px 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid var(--card-border);
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-dark);
            text-transform: uppercase;
            letter-spacing: -0.5px;
        }

        .logo span {
            color: var(--accent-color);
        }

        .search-container {
            flex: 0 1 450px;
            position: relative;
        }

        .search-container input {
            width: 100%;
            padding: 10px 18px;
            border-radius: 50px;
            border: 1px solid #e2e8f0;
            background: #fff;
            transition: 0.3s;
            outline: none;
            font-size: 14px;
        }

        .search-container input:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

        .cart-open-btn {
            background: var(--primary-dark);
            color: #fff;
            border: none;
            padding: 10px 22px;
            border-radius: 50px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.3s;
        }

        .cart-open-btn:hover {
            background: var(--accent-color);
            transform: translateY(-1px);
        }

        /* ===== CATEGORY BAR ===== */
        .category-nav {
            background: #fff;
            padding: 10px 60px;
            display: flex;
            gap: 30px;
            border-bottom: 1px solid var(--card-border);
            overflow-x: auto;
        }

        .cat-item {
            font-size: 14px;
            font-weight: 600;
            color: #64748b;
            cursor: pointer;
            white-space: nowrap;
            padding-bottom: 4px;
            border-bottom: 2px solid transparent;
        }

        .cat-item:hover {
            color: var(--accent-color);
            border-bottom: 2px solid var(--accent-color);
        }

        /* ===== PRODUCT CARDS ===== */
        .product-section {
            padding: 40px 60px;
        }

        .section-title {
            font-weight: 700;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 25px;
        }

        .product-card {
            background: #fff;
            border-radius: 20px;
            padding: 20px;
            border: 1px solid var(--card-border);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            flex-direction: column;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
            border-color: var(--accent-color);
        }

        .img-container {
            background: #f1f5f9;
            border-radius: 14px;
            height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin-bottom: 15px;
        }

        .product-card img {
            max-width: 80%;
            transition: 0.5s;
        }

        .product-card:hover img {
            transform: scale(1.1);
        }

        .p-name {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .p-category {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .p-price {
            font-size: 18px;
            font-weight: 800;
            color: var(--primary-dark);
            margin-bottom: 15px;
        }

        .action-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: auto;
        }

        .btn-modern {
            padding: 10px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            text-align: center;
            transition: 0.3s;
            border: none;
        }

        .btn-view {
            background: #f1f5f9;
            color: #475569;
        }

        .btn-view:hover {
            background: #e2e8f0;
        }

        .btn-add {
            background: var(--accent-color);
            color: #fff;
        }

        .btn-add:hover {
            background: var(--accent-hover);
        }

        /* ===== CART UI ===== */
        .cart-canvas {
            border-radius: 20px 0 0 20px;
            border: none;
        }

        .cart-item {
            display: flex;
            gap: 15px;
            background: #fff;
            padding: 15px;
            border-radius: 16px;
            margin-bottom: 15px;
            border: 1px solid var(--card-border);
        }

        .cart-item img {
            width: 60px;
            height: 60px;
            object-fit: contain;
            background: #f8fafc;
            border-radius: 10px;
        }

        /* ===== FOOTER ===== */
        .site-footer {
            background: #fff;
            padding: 60px;
            border-top: 1px solid var(--card-border);
        }

        @media (max-width: 768px) {
            header { padding: 15px 20px; flex-direction: column; gap: 15px; }
            .search-container { width: 100%; order: 3; }
            .product-section { padding: 20px; }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">Apna <span>STORE</span></div>
        
        <div class="search-container">
            <input type="text" id="searchInput" placeholder="Search curated products...">
        </div>

        <button class="cart-open-btn" data-bs-toggle="offcanvas" data-bs-target="#cartCanvas">
            🛒 Cart <span class="badge bg-primary rounded-pill"><%= cartCount %></span>
        </button>
    </header>

    <div class="category-nav">
        <% category.forEach(cat => { %>
            <div class="cat-item"><%= cat.categoryName %></div>
        <% }) %>
    </div>

    <div class="product-section">
        <h3 class="section-title">New Arrivals</h3>

        <div class="products-grid">
            <% product.forEach(p => { %>
                <div class="product-card">
                    <div class="img-container">
                        <img src="<%= p.productImage %>" alt="product">
                    </div>
                    <div class="p-category">Top Pick</div>
                    <div class="p-name product-name"><%= p.productName %></div>
                    <div class="p-price">₹<%= p.productPrice %></div>

                    <div class="action-group">
                        <a href="/web/singleview/<%= p.id %>" class="btn-modern btn-view">Details</a>
                        <form action="/web/addtocart/<%= p._id %>" method="post" style="display: flex;">
                            <button type="submit" class="btn-modern btn-add w-100">Add to Cart</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <div class="offcanvas offcanvas-end cart-canvas" tabindex="-1" id="cartCanvas">
        <div class="offcanvas-header border-bottom">
            <h5 class="fw-bold">Shopping Cart</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body bg-light">
            <% if(cartItems.length === 0){ %>
                <div class="text-center py-5">
                    <p class="text-muted">Your cart is feeling light.</p>
                </div>
            <% } %>

            <% cartItems.forEach(item => { %>
                <div class="cart-item">
                    <img src="<%= item.productId.productImage %>">
                    <div class="flex-grow-1">
                        <div class="p-name" style="font-size: 14px;"><%= item.productId.productName %></div>
                        <div class="d-flex align-items-center justify-content-between mt-2">
                            <input type="number" class="form-control form-control-sm qty-input" 
                                   value="<%= item.quantity %>" style="width: 60px;" 
                                   data-price="<%= item.productId.productPrice %>">
                            <span class="fw-bold text-success">₹<span class="item-total"><%= item.productId.productPrice * item.quantity %></span></span>
                        </div>
                        <a href="/web/deletecart/<%= item._id %>" class="text-danger x-small mt-2 d-inline-block text-decoration-none fw-bold" style="font-size: 12px;">Remove</a>
                    </div>
                </div>
            <% }) %>

            <div class="mt-4 p-3 bg-white rounded-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Total Amount</span>
                    <h4 class="mb-0 fw-bold text-primary">₹<span id="grandTotal">0</span></h4>
                </div>
                <button class="btn btn-dark w-100 mt-3 rounded-pill py-2">Checkout Now</button>
            </div>
        </div>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="logo mb-3">Apna <span>STORE</span></div>
                    <p class="text-muted small">Elevating your lifestyle with premium products delivered to your doorstep. Since 2026.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold mb-3">Customer Service</h6>
                    <ul class="list-unstyled small text-muted">
                        <li>Support</li>
                        <li>Returns</li>
                        <li>Tracking</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold mb-3">Newsletter</h6>
                    <div class="input-group">
                        <input type="text" class="form-control form-control-sm" placeholder="Email Address">
                        <button class="btn btn-dark btn-sm">Join</button>
                    </div>
                </div>
            </div>
            <div class="text-center mt-5 pt-4 border-top small text-muted">
                &copy; 2026 Apna  Store. Crafted with Care.
            </div>
        </div>
    </footer>

    <script>
        function updateTotals() {
            let grandTotal = 0;
            document.querySelectorAll('.cart-item').forEach(item => {
                let qtyInput = item.querySelector('.qty-input');
                let price = parseInt(qtyInput.dataset.price);
                let qty = parseInt(qtyInput.value) || 1;
                
                let itemTotal = qty * price;
                item.querySelector('.item-total').innerText = itemTotal;
                grandTotal += itemTotal;
            });
            document.getElementById('grandTotal').innerText = grandTotal;
        }

        document.querySelectorAll('.qty-input').forEach(input => {
            input.addEventListener('change', updateTotals);
        });

        // Initial Calculation
        updateTotals();

        // Simple Search
        const searchInput = document.getElementById("searchInput");
        searchInput.addEventListener("keyup", function() {
            let val = this.value.toLowerCase();
            document.querySelectorAll(".product-card").forEach(card => {
                let name = card.querySelector(".product-name").innerText.toLowerCase();
                card.style.display = name.includes(val) ? "flex" : "none";
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>