<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.productName %> | Apna  Store</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-dark: #121212;
            --accent-color: #4f46e5;
            --accent-hover: #4338ca;
            --bg-light: #f8fafc;
            --text-main: #1e293b;
            --card-border: rgba(0, 0, 0, 0.08);
        }

        body {
            margin: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-light);
            color: var(--text-main);
        }

        /* ===== HEADER ===== */
        header {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            padding: 15px 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid var(--card-border);
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary-dark);
            text-transform: uppercase;
            letter-spacing: -0.5px;
            text-decoration: none;
        }

        .logo span { color: var(--accent-color); }

        .back-btn {
            text-decoration: none;
            color: #64748b;
            font-weight: 600;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.3s;
        }

        .back-btn:hover { color: var(--accent-color); }

        /* ===== PRODUCT LAYOUT ===== */
        .main-wrapper {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .product-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 50px;
            background: #fff;
            padding: 40px;
            border-radius: 30px;
            border: 1px solid var(--card-border);
        }

        /* Image Display */
        .image-showcase {
            background: #f1f5f9;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
            position: sticky;
            top: 100px;
            height: fit-content;
        }

        .image-showcase img {
            max-width: 100%;
            max-height: 500px;
            object-fit: contain;
            mix-blend-mode: multiply;
        }

        /* Details Section */
        .info-col {
            display: flex;
            flex-direction: column;
        }

        .category-tag {
            font-size: 12px;
            font-weight: 700;
            color: var(--accent-color);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .product-title {
            font-size: 32px;
            font-weight: 800;
            line-height: 1.2;
            color: var(--primary-dark);
            margin-bottom: 15px;
        }

        .price-badge {
            font-size: 28px;
            font-weight: 800;
            color: var(--primary-dark);
            margin-bottom: 25px;
        }

        .desc-text {
            font-size: 16px;
            color: #64748b;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        /* Feature Cards */
        .offer-card {
            background: #fdf2f2;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 5px solid var(--accent-color);
        }

        .offer-card h6 {
            font-weight: 700;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .offer-card ul {
            padding-left: 20px;
            margin: 0;
            font-size: 14px;
            color: #475569;
        }

        /* CTAs */
        .action-tray {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px;
        }

        .btn-main {
            padding: 16px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 16px;
            border: none;
            transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-cart {
            background: #fff;
            color: var(--primary-dark);
            border: 2px solid var(--primary-dark);
        }

        .btn-cart:hover {
            background: var(--primary-dark);
            color: #fff;
        }

        .btn-buy {
            background: var(--accent-color);
            color: #fff;
        }

        .btn-buy:hover {
            background: var(--accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(79, 70, 229, 0.2);
        }

        .stock-info {
            margin-top: 30px;
            display: flex;
            gap: 20px;
            padding-top: 20px;
            border-top: 1px solid #f1f5f9;
            font-size: 13px;
            color: #94a3b8;
        }

        /* ===== FOOTER ===== */
        .site-footer {
            background: #fff;
            padding: 60px 0 20px;
            margin-top: 80px;
            border-top: 1px solid var(--card-border);
        }

        @media (max-width: 992px) {
            .product-grid { grid-template-columns: 1fr; padding: 25px; }
            header { padding: 15px 25px; }
        }
    </style>
</head>

<body>

    <header>
        <a href="/web" class="logo">Apna <span>STORE</span></a>
        <a href="/web" class="back-btn">← Back to Shop</a>
    </header>

    <div class="main-wrapper">
        <div class="product-grid">
            
            <div class="image-showcase">
                <img src="<%= product.productImage %>" alt="<%= product.productName %>">
            </div>

            <div class="info-col">
                <span class="category-tag"><%= product.categoryId.categoryName %></span>
                <h1 class="product-title"><%= product.productName %></h1>
                
                <div class="price-badge">₹<%= product.productPrice %></div>

                <div class="offer-card">
                    <h6>🎁 Special Deals</h6>
                    <ul>
                        <li>Flat 10% off on all Credit Card transactions.</li>
                        <li>Express 2-day delivery available in your area.</li>
                        <li>Free returns within 7 days of delivery.</li>
                    </ul>
                </div>

                <p class="desc-text">
                    <%= product.productDescription %>
                </p>

                <div class="action-tray">
                    <form action="/web/addtocart/<%= product._id %>" method="post" style="display: contents;">
                        <button type="submit" class="btn-main btn-cart">Add to Cart</button>
                    </form>
                    <button class="btn-main btn-buy">Buy It Now</button>
                </div>

                <div class="stock-info">
                    <span>✅ In Stock</span>
                    <span>🚚 Free Shipping</span>
                    <span>🛡️ 1 Year Warranty</span>
                </div>
            </div>
        </div>
    </div>

    <footer class="site-footer">
        <div class="container text-center">
            <div class="logo mb-4">Apna <span>STORE</span></div>
            <div class="row justify-content-center mb-4">
                <div class="col-auto"><a href="#" class="text-muted text-decoration-none px-3">Help</a></div>
                <div class="col-auto"><a href="#" class="text-muted text-decoration-none px-3">Privacy</a></div>
                <div class="col-auto"><a href="#" class="text-muted text-decoration-none px-3">Terms</a></div>
            </div>
            <p class="text-muted small">© 2026 Apna  Store — Premium Shopping Experience</p>
        </div>
    </footer>

</body>

</html>