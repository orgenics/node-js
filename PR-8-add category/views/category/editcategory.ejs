<%- include('../header')%>

<div class="page-wrapper" style="background: #f4f7f9; min-height: 100vh;">
    <div class="page-breadcrumb bg-white shadow-sm mb-4" style="padding: 20px 35px;">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="page-title mb-1 fw-bold text-dark">Update Category</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-transparent p-0 m-0">
                        <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
                        <li class="breadcrumb-item"><a href="/category/view-categories">Categories</a></li>
                        <li class="breadcrumb-item active text-primary fw-bold">Edit Mode</li>
                    </ol>
                </nav>
            </div>
            <a href="/category/view-categories" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="fas fa-undo mr-1"></i> Discard Changes
            </a>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
                    <form action="/category/update-category/<%= category.id %>" method="post" enctype="multipart/form-data">
                        <div class="card-body p-5">
                            <div class="row align-items-center">
                                <div class="col-md-5 text-center border-right">
                                    <label class="small fw-bold text-muted text-uppercase d-block mb-3">Category Visual</label>
                                    
                                    <div class="image-preview-wrapper mb-3">
                                        <img src="<%= category.categoryImage %>" id="main-preview" 
                                             class="img-fluid shadow-sm" 
                                             style="border-radius: 12px; max-height: 200px; width: 100%; object-fit: cover; border: 3px solid #fff;">
                                        <div class="badge-overlay">Current Image</div>
                                    </div>

                                    <div class="custom-file-upload mt-3">
                                        <input type="file" name="categoryImage" id="file-input" onchange="previewUpdate(this)">
                                        <label for="file-input" class="btn btn-light border w-100 mb-0">
                                            <i class="fas fa-camera mr-2"></i>Replace Image
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-7 pl-md-5 mt-4 mt-md-0">
                                    <h5 class="fw-bold mb-4 text-dark">Category Details</h5>
                                    
                                    <div class="form-floating-custom mb-4">
                                        <label class="small fw-bold text-muted text-uppercase mb-2 d-block">Display Name</label>
                                        <input type="text" class="form-control modern-field" 
                                               name="categoryName" placeholder="Enter Category Name"
                                               value="<%= category.categoryName %>" required>
                                        <small class="text-muted mt-1 d-block">This name will appear on the public storefront.</small>
                                    </div>

                                    <div class="alert alert-info border-0 py-2" style="background: #eef2ff; border-radius: 10px;">
                                        <small class="text-primary fw-bold">
                                            <i class="fas fa-info-circle mr-1"></i> ID: <%= category.id %>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-light p-4 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Last updated: Just now</span>
                            <button type="submit" class="btn btn-primary px-5 shadow" style="border-radius: 10px; font-weight: 600;">
                                Save Category Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Modern Field Styling */
    .modern-field {
        border: 2px solid #edf2f7;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 15px;
        transition: all 0.3s ease;
        background: #fcfcfc;
    }
    .modern-field:focus {
        border-color: #4e73df;
        background: #fff;
        box-shadow: 0 4px 12px rgba(78, 115, 223, 0.08);
    }

    /* Image Wrapper */
    .image-preview-wrapper {
        position: relative;
        display: inline-block;
        width: 100%;
    }
    .badge-overlay {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.6);
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 10px;
        text-transform: uppercase;
        backdrop-filter: blur(4px);
    }

    /* Hide Default File Input */
    .custom-file-upload input[type="file"] {
        display: none;
    }
    .custom-file-upload label {
        cursor: pointer;
        transition: 0.3s;
    }
    .custom-file-upload label:hover {
        background: #f1f3f5;
        border-color: #adb5bd;
    }
</style>

<script>
    function previewUpdate(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('main-preview').src = e.target.result;
                document.querySelector('.badge-overlay').innerHTML = "New Preview";
                document.querySelector('.badge-overlay').style.background = "#28a745";
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

<%- include('../footer')%>